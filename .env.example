# ─────────────────────────────────────────────────────────────────────────────
# Nilai di sini DIBAKAR ke dalam bundel saat `npm run build`, bukan dibaca saat
# aplikasi berjalan. Mengubahnya WAJIB diikuti build ulang, kalau tidak yang
# tersaji tetap nilai lama. Ini penyebab gambar/API menunjuk domain usang
# setelah pindah domain (23 Juli 2026).
# ─────────────────────────────────────────────────────────────────────────────

# Base URL API backend.
# Pakai '/api' relatif — mengikuti host yang sedang dibuka, jadi kebal terhadap
# pergantian domain sekaligus benar saat diakses dari HP di jaringan lokal.
# Development: /api        Production: /api
VITE_API_BASE_URL=/api

# Base URL gambar & storage.
# JANGAN dikosongkan di produksi. Puluhan berkas memakai pola
# `import.meta.env.VITE_IMAGE_BASE_URL || 'http://127.0.0.1:3001'` — string
# kosong itu falsy, sehingga produksi akan jatuh ke localhost dan semua gambar
# mati. Isi dengan origin absolut tanpa garis miring di akhir.
# Production: https://dpmd.bogorkab.go.id
VITE_IMAGE_BASE_URL=http://127.0.0.1:3001

# Production: https://dpmd.bogorkab.go.id/storage
VITE_STORAGE_BASE_URL=http://127.0.0.1:3001/storage

# VAPID Public Key untuk Push Notifications.
# Harus sama dengan VAPID_PUBLIC_KEY di .env backend. Mengganti pasangan kunci
# ini meng-invalidate seluruh langganan push yang sudah ada.
VITE_VAPID_PUBLIC_KEY=

# API Key untuk Laporan
VITE_LAPORAN_API_KEY=
